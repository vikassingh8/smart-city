# Copy to .env and fill in real values. .env is git-ignored.

# --- Azure SQL (relational sensor metadata) ---
SQL_SERVER=your-server.database.windows.net
SQL_DATABASE=your-database
SQL_USER=your-admin-user
SQL_PASSWORD=your-password
SQL_PORT=1433
SQL_ENCRYPT=true
SQL_TRUST_CERT=false

# --- Azure Data Explorer (time-series readings) ---
# Cluster query/engine endpoint (used for queries and streaming ingestion).
KUSTO_QUERY_URI=https://your-cluster.region.kusto.windows.net
KUSTO_DATABASE=smartcity

# Auth: by default the app uses DefaultAzureCredential — `az login` when running
# on your machine, or the managed identity on AKS. Nothing else to set.
#
# Only set these to force an Azure AD app registration instead (e.g. in CI or a
# fully-containerised run where `az login` is not available):
# AAD_APP_ID=your-app-client-id
# AAD_APP_KEY=your-app-client-secret
# AAD_TENANT_ID=your-tenant-id

# --- Kafka ---
KAFKA_BROKERS=localhost:29092

# --- API ---
API_PORT=3000

# --- Azure Key Vault (optional) ---
# Set to your vault name to load SQL_* secrets from Key Vault instead of above.
# Requires `az login` locally, or Managed Identity on AKS.
# KEYVAULT_NAME=smartcity-kv-7604

# --- Azure Application Insights (optional monitoring) ---
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...
